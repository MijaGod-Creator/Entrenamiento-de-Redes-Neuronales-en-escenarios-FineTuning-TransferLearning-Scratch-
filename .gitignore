# =====================================================
# Model weights - only keep champion models' best weights
# Exclude all non-champion model weights to save space
# =====================================================
# Exclude redundant checkpoints (final and latest are duplicates of best)
saved_models/**/final_model.pt
saved_models/**/latest_model.pt

# Exclude NON-champion models (users can retrain these)
saved_models/custom_cnn_*/
saved_models/vgg16_*/
saved_models/resnet50_*/
saved_models/mobilenetv2_*/
saved_models/efficientnetb0_*/
saved_models/densenet121_*/
saved_models/smoke_test/

